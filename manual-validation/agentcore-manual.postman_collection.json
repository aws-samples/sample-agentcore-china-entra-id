    {
      "name": "00 Obtain Entra application token using secret",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "https://login.partner.microsoftonline.cn/{{tenant_id}}/oauth2/v2.0/token",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{app_scope}}",
              "type": "text"
            }
          ]
        },
        "description": "Use only an approved local secret store. Manually use the returned access_token as app_access_token. Do not export actual secrets or tokens."
      },
      "response": []
    },
