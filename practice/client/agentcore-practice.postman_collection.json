      "item": [
        {
          "name": "Get application token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{machine_client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{machine_client_secret}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{api_uri}}/.default",
                  "type": "text"
                }
              ]
            },
            "url": "https://login.partner.microsoftonline.cn/{{tenant_id}}/oauth2/v2.0/token"
          }
