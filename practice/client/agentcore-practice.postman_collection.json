        "type": "oauth2",
        "oauth2": [
          {
            "key": "addTokenTo",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
