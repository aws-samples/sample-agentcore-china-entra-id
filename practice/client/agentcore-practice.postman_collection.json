{
  "info": {
    "name": "AgentCore console practice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual requests for employee Gateway access, IAM, application OAuth, Gateway client-credentials outbound, and Runtime MSAL OBO in AWS China. No scripts or credentials. User OAuth authorization and session binding use the supplied enterprise HTTPS application. See practice/user-delegation-setup.zh-CN.md."
  },
  "item": [
    {
      "name": "01 员工登录",
      "description": "Use this folder authorization. Initialize each endpoint separately; copy negotiated protocol version, returned session ID if any, and actual full tool name. OAuth user folders: use the native Authorization Code with PKCE dialog and Use Token.",
