              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{mcp_protocol_version}}"
              },
              {
                "key": "Mcp-Session-Id",
                "value": "{{mcp_session_id}}",
                "disabled": true,
                "description": "Enable only when the current initialize response returned a session ID."
